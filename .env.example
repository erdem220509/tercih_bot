OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
APP_ORIGIN=
ADVISOR_IP_LIMIT=12
ADVISOR_GLOBAL_HOURLY_LIMIT=200
# Set only when deployed behind a trusted reverse proxy (for example: 1)
TRUST_PROXY=

# PostHog project key and host, inlined into the Vite build at build time.
# These must be present in the build environment (or a local .env) when running
# `npm run build` / `npm run deploy`, otherwise the production bundle ships without them.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
